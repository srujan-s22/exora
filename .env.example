# ── Database ──
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/exora?retryWrites=true&w=majority
MONGODB_DB_NAME=exora

# ── Authentication ──
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this-in-production-immediately
JWT_EXPIRY=8h

# ── Application ──
NEXT_PUBLIC_APP_NAME=EXORA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Security ──
QR_HMAC_SECRET=your-separate-qr-signing-secret-min-32-chars-change-in-production
SUPER_ADMIN_SECRET=your-super-admin-activation-secret-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
TOTP_ENCRYPTION_KEY=your-32-byte-hex-totp-encryption-key-min-64-hex-chars

# ── Optional ──
LOG_LEVEL=info

# ── Geocoding & Maps (Google Maps Platform) ──
# Server-side ONLY geocoding API key (used by Geocoding API; never exposed to browser; do NOT prefix with NEXT_PUBLIC_)
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-api-key-for-geocoding
# Browser client-side public API key (used by Google Maps JavaScript API in ExoraMap; restrict via HTTP referrers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-public-api-key-for-browser-maps
# Optional: Google Cloud Map ID for cloud-styled vector maps
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── User Management Overhaul Bootstrap ──
BOOTSTRAP_SECRET=your-one-time-setup-activation-secret-key-change-in-production
ALLOW_BOOTSTRAP_OVERRIDE=false

